rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /members/{memberId} {
      allow read, write: if isSignedIn();
    }

    match /donations/{donationId} {
      allow read, write: if isSignedIn();
    }

    match /events/{eventId} {
      allow read, write: if isSignedIn();
    }
  }
}
