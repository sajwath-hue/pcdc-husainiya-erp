# Prisma datasource. SQLite by default for zero-dependency setup.
# For production, point this at a Postgres/MySQL instance and update
# prisma/schema.prisma's datasource provider accordingly.
DATABASE_URL="file:./dev.db"

# Random secret used to sign session tokens. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-in-production"

# Number of days an instalment must remain overdue before the system
# flags the loan as requiring a Payment Reminder Notice (spec section 8).
REMINDER_THRESHOLD_DAYS=30
